# Meta WhatsApp Cloud API
META_API_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_COSMOS_CONNECTION_STRING=
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=faktura-assets

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API (.NET, apps/api) — profil http de dev par défaut
NEXT_PUBLIC_API_URL=http://localhost:5221

# Auth Clerk (laisser vide = app en mode démo, sans authentification).
# Clés sur https://dashboard.clerk.com → API Keys. Côté API .NET, renseigner
# aussi Clerk:Authority (user-secrets) pour valider les JWT.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
